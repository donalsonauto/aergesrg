# The analyst chat needs an Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# (the same key works for the Claude Agent SDK). Copy this file to .env.local, paste the key, restart.
# It is read only on the server. It never goes to the browser.
ANTHROPIC_API_KEY=
# The model the analyst runs on. Leave as is unless you know why you are changing it.
ANTHROPIC_MODEL=claude-sonnet-5
