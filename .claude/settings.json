{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.env.development.local)",
      "Read(./.env.production.local)",
      "Read(./.env.test.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.development.local)",
      "Read(**/.env.production.local)",
      "Read(**/.env.test.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Edit(**/.env.local)",
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(gh repo create:*)"
    ],
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npx create-next-app:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  }
}
